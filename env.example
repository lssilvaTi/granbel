# KeepControl — envio de leads e rastreamento de visitas
# KEEPCONTROL_API_KEY é secreta e nunca deve usar o prefixo PUBLIC_.
KEEPCONTROL_BASE_URL=https://d88iqs55h7lnq.cloudfront.net
KEEPCONTROL_API_KEY=kc_live_substitua_aqui

# Valores públicos usados pelo script de rastreamento no navegador.
PUBLIC_KEEPCONTROL_BASE_URL=https://d88iqs55h7lnq.cloudfront.net
PUBLIC_KEEPCONTROL_SITE_KEY=substitua_pela_site_key

# EmailJS — notificação por e-mail adicional ao registro no KeepControl.
# Variáveis do template: from_name, from_phone, from_email, from_address,
# message e to_email.
PUBLIC_EMAILJS_SERVICE_ID=your_service_id
PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Cloudflare Turnstile (optional)
# https://developers.cloudflare.com/turnstile/
# If unset, honeypot-only anti-spam still applies.

PUBLIC_TURNSTILE_SITE_KEY=
